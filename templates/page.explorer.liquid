{% comment %}
  Shopify Explorer: the interactive Shopify architecture walkthrough for the team presentation.
  Copy of docs/shopify-explorer.html. Assign this template to a page (Online Store → Pages → Theme template: explorer).
  layout none: no theme header/footer/CSS. raw: the page shows Liquid code samples that must not be rendered.
{% endcomment %}
{% layout none %}
{% raw %}
<!doctype html>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Shopify Explorer</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500&display=swap">
<style>
  /* Layout: one stage, six zoom levels. Each level = a short title on top, one large visual below.
     Constructor brand: near-black ink, Constructor blue for "selected", the black → violet → coral gradient as the one flourish. */
  :root {
    --bg: #F0F3F7;
    --panel: #FFFFFF;
    --panel-2: #F4F6FA;
    --line: #D9DDE6;
    --ink: #010101;
    --muted: #5C6475;
    --faint: #A9B0BF;
    --on-accent: #FFFFFF;
    --blue: #0057B8;
    --blue-soft: rgba(0, 87, 184, 0.10);
    --violet-soft: rgba(103, 95, 166, 0.12);
    --grad-start: #010101;
    --grad-middle: #816AC5;
    --grad-end: #F1886F;
    --grad: linear-gradient(to right, var(--grad-start), var(--grad-middle), var(--grad-end));
    --shadow: 0 12px 32px rgba(1, 1, 1, 0.07);
    --code-kw: #675FA6;
    --code-str: #A8472A;
    --code-fn: #0057B8;
    --code-com: #8A92A3;
    --backdrop: rgba(240, 243, 247, 0.72);
    --font: "Manrope", "Helvetica Neue", Arial, sans-serif;
    --mono: "JetBrains Mono", ui-monospace, Menlo, monospace;
    --ease: cubic-bezier(0.7, 0, 0.2, 1);
    color-scheme: light;
  }
  html, body { height: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font);
    font-size: 15px;
    line-height: 1.5;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    overflow: hidden;
    padding-left: max(16px, env(safe-area-inset-left, 0px));
    padding-right: max(16px, env(safe-area-inset-right, 0px));
  }
  *, *::before, *::after { box-sizing: border-box; }
  button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
  :focus-visible { outline: 2px solid var(--blue); outline-offset: 3px; border-radius: 8px; }

  /* --- Chrome ----------------------------------------------------------------------------------- */
  .top { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding-block: 16px; flex-wrap: wrap; }
  /* Theme-only: a link back to the store's home page before the breadcrumbs. */
  .top-left { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; }
  .home { display: flex; align-items: center; gap: 6px; padding: 4px 8px; border-radius: 6px; color: var(--muted); font-size: 14px; text-decoration: none; }
  .home:hover { color: var(--ink); background: var(--panel); }
  .home svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linejoin: round; }
  .home-sep { color: var(--faint); font-size: 14px; }
  .crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; list-style: none; margin: 0; padding: 0; font-size: 14px; }
  .crumbs li { display: flex; align-items: center; gap: 4px; }
  .crumbs li + li::before { content: "›"; color: var(--faint); }
  .crumbs button { padding: 4px 8px; border-radius: 6px; color: var(--muted); }
  .crumbs button:hover { color: var(--ink); background: var(--panel); }
  .crumbs li:last-child button { color: var(--ink); font-weight: 700; }
  .dots { display: flex; gap: 6px; }
  .dots span { width: 22px; height: 4px; border-radius: 2px; background: var(--line); }
  .dots span.on { background: var(--grad); }
  .bottom { display: flex; justify-content: space-between; gap: 16px; padding-block: 10px 14px; font-size: 12px; color: var(--muted); flex-wrap: wrap; }
  kbd { font-family: var(--mono); font-size: 11px; border: 1px solid var(--line); border-radius: 4px; padding: 1px 5px; background: var(--panel); }

  .stage {
    position: relative;
    overflow: hidden;
    border-radius: 20px;
    background: radial-gradient(55% 65% at 70% 55%, var(--violet-soft), transparent 70%), var(--panel);
    box-shadow: var(--shadow);
  }
  .next {
    position: absolute; z-index: 5;
    right: 24px; bottom: 24px;
    width: 52px; height: 52px; border-radius: 50%;
    background: var(--grad); color: var(--on-accent);
    display: grid; place-items: center;
    box-shadow: var(--shadow);
    transition: transform 0.25s var(--ease);
  }
  .next:hover { transform: scale(1.08); }
  .next svg { width: 20px; height: 20px; }
  .next[hidden] { display: none; }

  /* --- Levels ----------------------------------------------------------------------------------- */
  .level {
    position: absolute; inset: 0;
    visibility: hidden;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    gap: 24px;
    padding: 40px 48px 48px;
    overflow: auto;
    will-change: transform, opacity;
  }
  .level.active { visibility: visible; }
  .head { display: grid; gap: 6px; }
  .eyebrow { font-family: var(--mono); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin: 0; }
  h2 { font-weight: 800; font-size: 40px; line-height: 1.08; letter-spacing: -0.035em; margin: 0; text-wrap: balance; }
  .g { background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .lede { margin: 0; color: var(--muted); font-size: 16px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .vis { position: relative; min-height: 0; min-width: 0; display: grid; place-items: center; }

  /* Pulsing ring on the element the next step zooms into. */
  .beacon { position: relative; }
  .beacon::after {
    content: ""; position: absolute; inset: -6px; border-radius: inherit;
    border: 2px solid var(--grad-middle); opacity: 0;
    animation: ping 2.4s var(--ease) infinite; pointer-events: none;
  }
  @keyframes ping { 0% { opacity: 0.7; transform: scale(0.96); } 80%, 100% { opacity: 0; transform: scale(1.12); } }

  /* 0 · Shopify */
  .l0 { grid-template-rows: minmax(0, 1fr) auto; justify-items: center; text-align: center; }
  .planet { position: relative; height: min(52vh, 440px); aspect-ratio: 1; max-width: 100%; }
  .planet svg.orbits { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .ring { fill: none; stroke: var(--line); stroke-width: 1.5; }
  .ring.dash { stroke-dasharray: 2 8; }
  .orbit { transform-origin: 200px 200px; animation: spin 50s linear infinite; }
  .orbit.rev { animation-duration: 80s; animation-direction: reverse; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .orbit circle { fill: var(--faint); }
  .orbit circle.c { fill: var(--grad-end); }
  .orbit circle.v { fill: var(--grad-middle); }
  .bag { position: absolute; left: 50%; top: 50%; width: 34%; aspect-ratio: 1; transform: translate(-50%, -50%); border-radius: 50%; }
  .bag svg { width: 100%; height: 100%; transition: transform 0.4s var(--ease); }
  .bag:hover svg { transform: scale(1.06); }
  .bag-glow { fill: var(--grad-middle); opacity: 0.3; filter: blur(24px); }
  .bag-body { fill: url(#bagGrad); }
  .bag-handle { fill: none; stroke: var(--ink); stroke-width: 9; stroke-linecap: round; }
  .bag-mark { fill: var(--on-accent); font-weight: 800; font-family: var(--font); }
  .l0 h2 { font-size: 64px; }
  .kpis { display: flex; justify-content: center; gap: 40px; flex-wrap: wrap; margin-top: 10px; }
  .kpi b { display: block; font-size: 28px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .kpi span { font-size: 13px; color: var(--muted); }

  /* 1 · Stores */
  .field { position: absolute; inset: 0; }
  .field canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .pin {
    position: absolute; transform: translate(-50%, -50%);
    display: flex; align-items: center; gap: 8px;
    padding: 8px 14px 8px 10px; border-radius: 999px;
    background: var(--panel); box-shadow: var(--shadow), 0 0 0 1px var(--line);
    font-size: 14px; font-weight: 700; white-space: nowrap;
    transition: transform 0.3s var(--ease);
  }
  .pin:hover { transform: translate(-50%, -50%) scale(1.06); }
  .si { width: 26px; height: 26px; border-radius: 8px; background: var(--panel-2); display: grid; place-items: center; flex: none; }
  .si svg { width: 16px; height: 16px; fill: none; stroke: var(--ink); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .pin.plus .si { background: var(--grad); }
  .pin.plus .si svg { stroke: var(--on-accent); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--grad-middle); display: inline-block; }

  /* 2 · Store: one theme is served, the others can be published */
  .store { width: min(980px, 100%); display: grid; gap: 22px; }
  .store-head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .avatar { width: 40px; height: 40px; border-radius: 12px; background: var(--grad); display: grid; place-items: center; }
  .avatar svg, .crowd svg { width: 22px; height: 22px; fill: none; stroke: var(--on-accent); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .store-head b { font-size: 18px; }
  .store-head span { font-family: var(--mono); font-size: 12px; color: var(--muted); }
  .lib { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) 150px 190px; align-items: center; }
  .tcards { position: relative; display: grid; gap: 14px; padding-left: 34px; }
  .tcards::before { content: ""; position: absolute; left: 10px; top: 40px; bottom: 40px; width: 2px; background: var(--line); }
  .tcard { position: relative; display: flex; align-items: center; gap: 14px; padding: 12px 14px 12px 12px; border-radius: 16px; background: var(--panel); box-shadow: var(--shadow), 0 0 0 1px var(--line); transition: box-shadow 0.4s, opacity 0.4s; }
  .tcard:not(.live) { opacity: 0.75; }
  .tcard:not(.live):hover { opacity: 1; }
  .tcard.live { box-shadow: var(--shadow), 0 0 0 2px var(--grad-middle); }
  .tcard .node { position: absolute; left: -31px; top: 50%; width: 16px; height: 16px; margin-top: -8px; border-radius: 50%; background: var(--panel); border: 3px solid var(--faint); transition: all 0.4s; }
  .tcard.live .node { background: var(--grad); border-color: var(--panel); box-shadow: 0 0 0 2px var(--grad-middle); }
  .tcard.live .node { animation: nodePing 2.4s var(--ease) infinite; }
  @keyframes nodePing { 0% { box-shadow: 0 0 0 2px var(--grad-middle), 0 0 0 2px var(--violet-soft); } 70%, 100% { box-shadow: 0 0 0 2px var(--grad-middle), 0 0 0 14px transparent; } }
  .tbody { display: flex; align-items: center; gap: 14px; flex: 1; min-width: 0; text-align: left; border-radius: 10px; }
  .thumb { width: 92px; flex: none; aspect-ratio: 4 / 3; border-radius: 8px; background: var(--panel-2); padding: 6px; display: grid; grid-template-rows: 4px 1fr 8px; gap: 4px; }
  .thumb i { display: block; border-radius: 2px; background: var(--line); }
  .thumb .hero { background: var(--hero); }
  .tname { min-width: 0; }
  .tname b { display: block; font-size: 16px; }
  .tname span { font-size: 13px; color: var(--muted); }
  .tcard.live .tname span { color: var(--ink); font-weight: 600; }
  .publish { font-size: 13px; font-weight: 700; padding: 8px 14px; border-radius: 999px; box-shadow: 0 0 0 1px var(--line); transition: background 0.25s, color 0.25s, box-shadow 0.25s; }
  .publish:hover { background: var(--ink); color: var(--on-accent); box-shadow: none; }
  .tcard .live-pill { display: none; font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; padding: 6px 10px; border-radius: 999px; background: var(--ink); color: var(--on-accent); }
  .tcard.live .live-pill { display: inline-block; }
  .tcard.live .publish { display: none; }
  .shoppers { grid-column: 3; display: grid; justify-items: center; gap: 10px; text-align: center; }
  .crowd { width: 108px; aspect-ratio: 1; border-radius: 28px; background: var(--grad); display: grid; place-items: center; box-shadow: var(--shadow); }
  .crowd svg { width: 46px; height: 46px; stroke-width: 1.5; }
  .shoppers b { font-size: 15px; }
  .shoppers span { font-family: var(--mono); font-size: 11px; color: var(--muted); }
  .serve { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; overflow: visible; }
  .serve path { fill: none; stroke: url(#serveGrad); stroke-width: 3; stroke-linecap: round; stroke-dasharray: 2 10; animation: flow 0.9s linear infinite; }
  @keyframes flow { to { stroke-dashoffset: -12; } }
  .serve circle { fill: var(--grad-middle); }

  /* 3 · Theme: folder tree + a real collection page with an inspector overlay */
  .l3 { grid-template-rows: none; grid-template-columns: minmax(250px, 320px) minmax(0, 1fr); align-items: center; gap: 40px; }
  .l3 .desc { color: var(--muted); margin: 12px 0 16px; max-width: 46ch; }
  .l3 .desc strong { color: var(--ink); }
  .detail { background: var(--panel); box-shadow: var(--shadow), 0 0 0 1px var(--line); border-radius: 14px; padding: 14px 16px; min-height: 150px; }
  .detail b { font-family: var(--mono); font-size: 13px; color: var(--blue); font-weight: 500; }
  .detail p { margin: 6px 0 10px; font-size: 14px; }
  .detail code { display: block; font-family: var(--mono); font-size: 12px; color: var(--muted); white-space: pre-wrap; background: var(--panel-2); border-radius: 8px; padding: 8px 10px; }
  .cta { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 14px; padding: 10px 16px; border-radius: 10px; background: var(--grad); color: var(--on-accent); margin-top: 16px; }
  .cta:hover { filter: brightness(1.08); }
  .theme-vis { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 18px; align-items: start; min-width: 0; }
  .tree { display: grid; gap: 4px; font-family: var(--mono); font-size: 13px; padding-top: 6px; }
  .tree button { display: flex; align-items: center; gap: 10px; text-align: left; padding: 8px 10px; border-radius: 8px; color: var(--muted); transition: background 0.2s, color 0.2s; }
  .tree button::before { content: ""; width: 14px; height: 11px; border-radius: 2px; border: 1.5px solid currentColor; opacity: 0.7; flex: none; }
  .tree button[aria-pressed="true"] { background: var(--blue-soft); color: var(--blue); }
  .tree button:hover { color: var(--ink); }
  .auto { display: flex; align-items: center; gap: 8px; padding: 4px 10px 10px; font-family: var(--font); font-size: 13px; font-weight: 600; color: var(--muted); cursor: pointer; user-select: none; }
  .auto input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .switch { position: relative; width: 30px; height: 18px; border-radius: 999px; background: var(--line); transition: background 0.25s; flex: none; }
  .switch::after { content: ""; position: absolute; left: 2px; top: 2px; width: 14px; height: 14px; border-radius: 50%; background: var(--panel); box-shadow: 0 1px 2px rgba(1, 1, 1, 0.2); transition: transform 0.25s var(--ease); }
  .auto input:checked + .switch { background: var(--grad); }
  .auto input:checked + .switch::after { transform: translateX(12px); }
  .auto input:focus-visible + .switch { outline: 2px solid var(--blue); outline-offset: 2px; }
  .auto:has(input:checked) { color: var(--ink); }

  .browser { position: relative; border-radius: 14px; background: var(--panel); box-shadow: var(--shadow), 0 0 0 1px var(--line); overflow: hidden; min-width: 0; }
  .chrome { display: flex; align-items: center; gap: 12px; padding: 9px 12px; background: var(--panel-2); border-bottom: 1px solid var(--line); }
  .chrome .lights { display: flex; gap: 6px; }
  .chrome .lights i { width: 9px; height: 9px; border-radius: 50%; background: var(--line); }
  .addr { flex: 1; font-family: var(--mono); font-size: 11px; color: var(--muted); background: var(--panel); border-radius: 6px; padding: 4px 10px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .plp { color: var(--ink); font-size: 12px; }
  .p-header { display: flex; align-items: center; gap: 18px; padding: 12px 18px; border-bottom: 1px solid var(--panel-2); }
  .p-logo { font-weight: 800; letter-spacing: 0.14em; font-size: 13px; }
  .p-nav { display: flex; gap: 14px; color: var(--muted); font-weight: 600; }
  .p-search { margin-left: auto; width: 34%; display: flex; align-items: center; gap: 6px; padding: 6px 10px; border-radius: 999px; background: var(--panel-2); color: var(--faint); }
  .p-search svg, .p-cart svg { width: 13px; height: 13px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  .p-cart { color: var(--ink); display: grid; }
  .p-main { padding: 14px 18px; display: grid; gap: 12px; }
  .p-banner { padding: 4px 0; }
  .p-banner h3 { margin: 0; font-size: 22px; font-weight: 800; letter-spacing: -0.02em; display: inline-block; }
  .p-banner p { margin: 2px 0 0; color: var(--muted); }
  .p-gridsec { display: grid; gap: 10px; }
  .p-toolbar { display: flex; gap: 8px; align-items: center; color: var(--muted); }
  .p-toolbar span { padding: 4px 10px; border-radius: 999px; box-shadow: 0 0 0 1px var(--line); font-weight: 600; color: var(--ink); }
  .p-toolbar em { margin-left: auto; font-style: normal; }
  .p-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .p-card { display: grid; gap: 6px; }
  .p-img { aspect-ratio: 1 / 0.85; border-radius: 10px; background: var(--tile); display: grid; place-items: center; }
  .p-img svg { width: 78%; height: auto; }
  .shoe-up { fill: var(--shoe); }
  .shoe-sole { fill: var(--panel); }
  .shoe-line { fill: none; stroke: var(--panel); stroke-width: 2.2; stroke-linecap: round; opacity: 0.85; }
  .p-title { font-weight: 700; }
  .p-price { color: var(--muted); display: inline-block; justify-self: start; }
  .p-footer { padding: 12px 18px; border-top: 1px solid var(--panel-2); color: var(--faint); display: flex; gap: 16px; }
  .devtools { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; padding: 8px 12px; background: var(--panel-2); border-top: 1px solid var(--line); font-family: var(--mono); font-size: 11px; color: var(--muted); }
  .devtools > b { font-weight: 500; color: var(--ink); margin-right: 4px; }
  .devtools span { padding: 3px 8px; border-radius: 6px; background: var(--panel); }
  .devtools .sep { margin-left: auto; background: none; padding: 0; }

  .inspect { position: absolute; inset: 0; pointer-events: none; }
  .ov { position: absolute; border: 1.5px solid var(--blue); background: var(--blue-soft); border-radius: 6px; animation: ovIn 0.35s var(--ease); }
  .ov b { position: absolute; left: -1.5px; bottom: 100%; margin-bottom: 3px; font-family: var(--mono); font-weight: 500; font-size: 10.5px; white-space: nowrap; color: var(--on-accent); background: var(--blue); padding: 2px 7px; border-radius: 4px; }
  .ov.below b { bottom: auto; top: 100%; margin: 3px 0 0; }
  @keyframes ovIn { from { opacity: 0; transform: scale(0.98); } }

  .swap { animation: swap 0.45s var(--ease); }
  @keyframes swap { from { opacity: 0; transform: translateY(6px); } }

  /* 4 · Build setup: src/ → webpack → assets/ → theme file */
  .build { width: min(1340px, 100%); display: grid; gap: 26px; }
  .flow { position: relative; display: grid; align-items: start; grid-template-rows: auto 1fr; grid-template-columns: minmax(0, 1fr) 30px minmax(0, 1fr) 30px minmax(0, 1fr) 30px minmax(0, 1fr) 30px minmax(0, 1.35fr); }
  /* Same rows as the theme page's folder tree, plus the dev-only files. */
  #bRepo { grid-row: 1 / span 2; }
  .flow-foot { grid-column: 3 / -1; grid-row: 2; display: grid; gap: 22px; align-content: start; padding-top: 34px; }
  .repo { display: grid; gap: 4px; font-family: var(--mono); font-size: 13px; }
  .repo-label { font-family: var(--font); font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); margin: 8px 0 2px; padding-inline: 10px; display: flex; justify-content: space-between; align-items: center; gap: 6px; }
  .trow { display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-radius: 8px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; transition: color 0.4s, background 0.4s; }
  .trow::before { content: ""; width: 14px; height: 11px; border-radius: 2px; border: 1.5px solid currentColor; opacity: 0.7; flex: none; }
  .repo-list { display: grid; gap: 4px; }
  .trow.isfile::before { width: 10px; height: 13px; margin-inline: 2px; }
  .ignoring .ign .trow { color: var(--faint); text-decoration: line-through; text-decoration-color: var(--faint); }
  .ignoring .ign .trow.src-row { text-decoration: none; color: var(--blue); background: var(--blue-soft); }
  .ign-badge { font-family: var(--mono); font-size: 10px; letter-spacing: 0.06em; padding: 2px 6px; border-radius: 999px; background: var(--panel-2); color: var(--muted); opacity: 0; transition: opacity 0.4s; }
  .ignoring .ign-badge { opacity: 1; }
  .arrow { align-self: start; margin-top: 30px; height: 2px; margin-inline: 4px; background: var(--line); position: relative; }
  .arrow::after { content: ""; position: absolute; right: -2px; top: -5px; border: 6px solid transparent; border-left: 8px solid var(--line); border-right: 0; }
  .fcard { background: var(--panel); border-radius: 16px; box-shadow: var(--shadow), 0 0 0 1px var(--line); padding: 14px; display: grid; gap: 8px; align-content: start; transition: box-shadow 0.35s; min-width: 0; }
  .fcard.on { box-shadow: var(--shadow), 0 0 0 2px var(--blue); }

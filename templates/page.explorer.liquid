    const wrap = $("edWrap");
    wrap.hidden = false;
    edOpen = true;
    const s = stage.getBoundingClientRect(), r = fromEl.getBoundingClientRect();
    const ed = $("editor"), e = ed.getBoundingClientRect();
    ed.style.transformOrigin = `${r.left + r.width / 2 - e.left}px ${r.top + r.height / 2 - e.top}px`;
    if (!reduced) {
      ed.animate([{ transform: "scale(0.2)", opacity: 0 }, { transform: "scale(1)", opacity: 1 }], { duration: 520, easing: "cubic-bezier(0.65, 0, 0.25, 1)" });
      wrap.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 300 });
    }
    $("edClose").focus({ preventScroll: true });
  }
  function closeEditor() {
    if (!edOpen) return;
    edOpen = false;
    const wrap = $("edWrap"), ed = $("editor");
    if (reduced) { wrap.hidden = true; return; }
    ed.animate([{ transform: "scale(1)", opacity: 1 }, { transform: "scale(0.2)", opacity: 0 }], { duration: 380, easing: "cubic-bezier(0.65, 0, 0.25, 1)" });
    wrap.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 380 }).onfinish = () => { wrap.hidden = true; };
  }

  stage.addEventListener("click", (e) => {
    const t = e.target.closest("[data-open]");
    if (t && !edOpen) openEditor(t.dataset.open, t);
  });
  stage.addEventListener("keydown", (e) => {
    const t = e.target.closest("[data-open]");
    if (t && (e.key === "Enter" || e.key === " ")) { e.preventDefault(); openEditor(t.dataset.open, t); }
  });
  $("edWrap").addEventListener("click", (e) => { if (e.target === $("edWrap")) closeEditor(); });
  $("edClose").addEventListener("click", closeEditor);
  document.querySelectorAll("#edTabs .tab, .ed-side .ex[data-file]").forEach((b) => b.addEventListener("click", () => showFile(b.dataset.file)));

  /* --- Start ------------------------------------------------------------------------------------ */

  const startIdx = Math.max(0, levels.findIndex((l) => l.dataset.id === location.hash.slice(1)));
  state.current = startIdx;
  levels[startIdx].classList.add("active");
  fillStore();
  renderChrome();
  enter(startIdx);
</script>


<script>
  const stage = document.getElementById("stage");
  const levels = [...document.querySelectorAll(".level")];
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const css = (name) => getComputedStyle(document.documentElement).getPropertyValue(name).trim();
  const $ = (id) => document.getElementById(id);

  const state = { current: 0, busy: false, origins: [], store: "Fieldhouse Shoes", theme: "Horizon" };

  const SOURCES = [
    "Shopify FY2025 and Q2 2026 results.",
    "Store Leads, Oct 2026 (tracker estimate). One dot ≈ 1,300 stores. Store names are illustrative.",
    "Illustrative store.",
    "Online Store 2.0 theme structure.",
    "From the Constructor demo theme: .shopifyignore, webpack.config.js and docs/build-setup.md.",
  ];

  /* --- Navigation ------------------------------------------------------------------------------- */

  function renderChrome() {
    const labels = ["Shopify", "Stores", state.store, state.theme, "Build setup"];
    const crumbs = $("crumbs");
    crumbs.innerHTML = "";
    labels.slice(0, state.current + 1).forEach((label, i) => {
      const li = document.createElement("li");
      const b = document.createElement("button");
      b.textContent = label;
      if (i === state.current) b.setAttribute("aria-current", "step");
      b.addEventListener("click", () => go(i));
      li.appendChild(b);
      crumbs.appendChild(li);
    });
    $("dots").innerHTML = levels.map((_, i) => `<span class="${i <= state.current ? "on" : ""}"></span>`).join("");
    $("source").textContent = SOURCES[state.current];
    $("next").hidden = state.current === levels.length - 1;
    try { history.replaceState(null, "", "#" + levels[state.current].dataset.id); } catch (e) {}
  }

  function pointOf(el) {
    const s = stage.getBoundingClientRect();
    if (!el) return { x: s.width / 2, y: s.height / 2 };
    const r = el.getBoundingClientRect();
    return { x: r.left + r.width / 2 - s.left, y: r.top + r.height / 2 - s.top };
  }

  function go(next, originEl) {
    if (state.busy || next === state.current || next < 0 || next >= levels.length) return;
    const from = levels[state.current], to = levels[next];
    const forward = next > state.current;
    // Forward zooms into what was clicked; back zooms out through the same point.
    const p = forward ? pointOf(originEl) : state.origins[state.current] || pointOf(null);
    if (forward) state.origins[next] = p;

    leave(state.current);
    state.busy = true;
    state.current = next;
    to.classList.add("active");
    to.scrollTop = 0;
    renderChrome();
    enter(next);

    const origin = `${p.x}px ${p.y}px`;
    from.style.transformOrigin = origin;
    to.style.transformOrigin = origin;
    const opts = { duration: reduced ? 250 : 800, easing: "cubic-bezier(0.65, 0, 0.25, 1)", fill: "both" };
    const big = reduced ? 1 : 2.4, small = reduced ? 1 : 0.35;
    const out = from.animate(
      [{ transform: "scale(1)", opacity: 1 }, { transform: `scale(${forward ? big : small})`, opacity: 0 }], opts);
    to.animate(
      [{ transform: `scale(${forward ? small : big})`, opacity: 0 }, { transform: "scale(1)", opacity: 1 }], opts);
    out.onfinish = () => {
      from.classList.remove("active");
      from.getAnimations().forEach((a) => a.cancel());
      to.getAnimations().forEach((a) => a.cancel());
      state.busy = false;
    };
  }

  function forward() {
    const lvl = levels[state.current];
    go(state.current + 1, lvl.querySelector("[data-default]") || lvl.querySelector("[data-go]"));
  }

  stage.addEventListener("click", (e) => {
    const t = e.target.closest("[data-go]");
    if (!t || !levels[state.current].contains(t)) return;
    if (t.dataset.store) { state.store = t.dataset.store; fillStore(); }
    if (t.dataset.theme) state.theme = t.dataset.theme;
    // The theme's CTA zooms out of the loaded assets strip, which is where the build output ends up.
    go(state.current + 1, t.id === "buildCta" ? document.querySelector(".devtools") : t);
  });
  // The branch labels are SVG groups, so give them button keyboard behaviour.
  stage.addEventListener("keydown", (e) => {
    const t = e.target.closest('[role="button"][data-go]');
    if (t && (e.key === "Enter" || e.key === " ")) { e.preventDefault(); e.stopPropagation(); t.dispatchEvent(new MouseEvent("click", { bubbles: true })); }
  });

  // The flowing line runs from whichever theme is live to the shoppers.
  function drawServe(animate) {
    const lib = $("lib"), live = lib.querySelector(".tcard.live");
    if (!live) return;
    const L = lib.getBoundingClientRect(), a = live.getBoundingClientRect();
    const b = $("shoppers").querySelector(".crowd").getBoundingClientRect();
    const x1 = a.right - L.left, y1 = a.top + a.height / 2 - L.top;
    const x2 = b.left - L.left - 8, y2 = b.top + b.height / 2 - L.top;
    const d = `M${x1} ${y1} C ${x1 + 70} ${y1}, ${x2 - 70} ${y2}, ${x2} ${y2}`;
    const path = $("servePath");
    path.setAttribute("d", d);
    $("serveDot").setAttribute("cx", x2);
    $("serveDot").setAttribute("cy", y2);
    if (animate && !reduced) path.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 500, easing: "ease-out" });
  }

  $("tcards").addEventListener("click", (e) => {
    const btn = e.target.closest(".publish");
    if (!btn) return;
    const card = btn.closest(".tcard");
    $("tcards").querySelectorAll(".tcard").forEach((c) => {
      const isLive = c === card;
      c.classList.toggle("live", isLive);
      c.querySelector(".tname span").textContent = isLive ? "Served to shoppers" : "Ready to publish";
      const body = c.querySelector(".tbody");
      body.toggleAttribute("data-default", isLive);
    });
    drawServe(true);
  });
  addEventListener("resize", () => { if (levels[state.current].dataset.id === "store") drawServe(false); });
  $("next").addEventListener("click", forward);
  addEventListener("keydown", (e) => {
    if (edOpen) { if (e.key === "Escape") { e.preventDefault(); closeEditor(); } return; }
    if (e.target.closest && e.target.closest("[data-open]") && (e.key === "Enter" || e.key === " ")) return;
    if (e.key === "ArrowRight" || e.key === "PageDown") { e.preventDefault(); forward(); }
    else if (e.key === "ArrowLeft" || e.key === "PageUp" || e.key === "Escape") { e.preventDefault(); go(state.current - 1); }
  });

  function fillStore() {
    const slug = state.store.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
    $("storeName").textContent = state.store;
    $("storeDomain").textContent = `${slug}.myshopify.com`;
    $("shopDomain").textContent = `${slug}.com`;
    $("plpAddr").textContent = `${slug}.com/collections/shoes`;
    $("plpLogo").textContent = state.store.split(" ")[0].toUpperCase();
  }

  /* --- Enter / leave ---------------------------------------------------------------------------- */

  const hooks = {
    shopify: { enter: () => countUp(levels[0]) },
    stores: { enter: () => { countUp(levels[1]); startField(); }, leave: stopField },
    store: { enter: () => drawServe(true) },
    theme: { enter: startTour, leave: stopTour },
    build: { enter: () => playBuild(0), leave: () => { stopBuild(); closeEditor(); } },
  };
  const enter = (i) => hooks[levels[i].dataset.id]?.enter?.();
  const leave = (i) => hooks[levels[i].dataset.id]?.leave?.();

  function countUp(root) {
    root.querySelectorAll(".count").forEach((el) => {
      const to = Number(el.dataset.to), dec = Number(el.dataset.dec || 0);
      const fmt = (v) => (el.dataset.prefix || "") + v.toFixed(dec) + (el.dataset.suffix || "");
      if (reduced) { el.textContent = fmt(to); return; }
      const t0 = performance.now();
      const tick = (t) => {
        const k = Math.min(1, (t - t0) / 1400);
        el.textContent = fmt(to * (1 - Math.pow(1 - k, 3)));
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    });
  }

  /* --- 1 · Store field -------------------------------------------------------------------------- */

  const canvas = $("dotsCanvas");
  const ctx = canvas.getContext("2d");
  let seed = 11;
  const rand = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
  const gauss = () => Math.sqrt(-2 * Math.log(rand() + 1e-9)) * Math.cos(2 * Math.PI * rand());
  // ~2,400 dots for 3.19M stores, so one dot ≈ 1,300 stores; 2.6% are Plus.
  const clusters = [[0.3, 0.4, 0.13], [0.55, 0.32, 0.1], [0.72, 0.58, 0.12], [0.42, 0.68, 0.1], [0.84, 0.3, 0.07]];
  const field = [];
  for (let i = 0; i < 2400; i++) {
    const c = clusters[Math.floor(rand() * clusters.length)];
    const x = c[0] + gauss() * c[2], y = c[1] + gauss() * c[2] * 0.8;
    if (x < 0.02 || x > 0.98 || y < 0.04 || y > 0.96) continue;
    field.push({ x, y, plus: rand() < 0.026, r: 1 + rand() * 1.2, ph: rand() * 6.28 });
  }
  let fieldRaf = 0, fieldT0 = 0;

  function sizeCanvas() {
    const r = canvas.getBoundingClientRect(), dpr = devicePixelRatio || 1;
    canvas.width = Math.max(1, r.width * dpr);
    canvas.height = Math.max(1, r.height * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  function drawField(t) {
    const r = canvas.getBoundingClientRect();
    ctx.clearRect(0, 0, r.width, r.height);
    const faint = css("--faint"), plus = css("--grad-middle");
    const k = reduced ? 9 : (t - fieldT0) / 1600;
    for (const d of field) {
      const a = Math.max(0, Math.min(1, (k - Math.hypot(d.x - 0.5, d.y - 0.5) * 0.9) / 0.25));
      if (!a) continue;
      ctx.globalAlpha = a * (d.plus ? 0.7 + 0.3 * Math.sin(t / 800 + d.ph) : 0.55);
      ctx.fillStyle = d.plus ? plus : faint;
      ctx.beginPath();
      ctx.arc(d.x * r.width, d.y * r.height, d.plus ? d.r + 1.6 : d.r, 0, 6.283);
      ctx.fill();
    }
    ctx.globalAlpha = 1;
  }
  function startField() {
    sizeCanvas();
    fieldT0 = performance.now();
    if (reduced) { drawField(fieldT0); return; }
    const loop = (t) => { drawField(t); fieldRaf = requestAnimationFrame(loop); };
    fieldRaf = requestAnimationFrame(loop);
  }
  function stopField() { cancelAnimationFrame(fieldRaf); }
  addEventListener("resize", () => { if (levels[state.current].dataset.id === "stores") { sizeCanvas(); drawField(performance.now()); } });

  /* --- 3 · Theme tour --------------------------------------------------------------------------- */

  const PARTS = {
    layout: ["layout/theme.liquid", "The frame around every page: the <head>, header and footer. The page's template is rendered into it.", "{{ content_for_header }}\n…\n{{ content_for_layout }}"],
    templates: ["templates/collection.json", "One per page type: product, collection, search, cart. A JSON list of sections and their order. A page can use an alternate, like collection.cio-plp-ui.json.", '{ "sections": { "banner": {…}, "grid": {…} },\n  "order": ["banner", "grid"] }'],
    sections: ["sections/*.liquid", "Reusable bands of a page. Each has a schema of settings the merchant edits in the theme editor, without code.", '{% schema %} { "name": "Product grid", … } {% endschema %}'],
    blocks: ["blocks/*.liquid", "Smaller pieces inside a section: a heading, a product card, a search box. Merchants add, remove and reorder them. Apps can add blocks too.", "{% content_for 'blocks' %}"],
    snippets: ["snippets/*.liquid", "Shared partials, like a price or a product image. Sections and blocks render them. Merchants never see them.", "{% render 'price', product: product %}"],
    assets: ["assets/", "Static JS, CSS and images, loaded by the page. Shopify serves them from its CDN exactly as they are. It doesn't build anything, so a developer builds and commits the minified files.", "<script src=\"{{ 'cio-plp-ui.min.js' | asset_url }}\" defer>"],
    config: ["config/", "Theme-wide settings like colours and fonts, plus the merchant's saved choices, including which app embeds are on.", "settings_schema.json · settings_data.json"],
    locales: ["locales/", "Translations for the theme's own text, like the menu labels. One file per language.", "en.default.json · fr.json · de.json"],
  };
  const order = Object.keys(PARTS);
  let tourTimer = 0, tourIdx = 0;

  let currentPart = "layout";
  // Draws DevTools-style inspector boxes over every element of the page that comes from `part`.
  function showPart(part) {
    currentPart = part;
    document.querySelectorAll("#tree button").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.part === part)));
    const [name, text, code] = PARTS[part];
    const d = $("detail");
    d.innerHTML = "";
    const b = document.createElement("b"); b.textContent = name;
    const p = document.createElement("p"); p.textContent = text;
    const c = document.createElement("code"); c.textContent = code;
    d.append(b, p, c);
    d.classList.remove("swap"); void d.offsetWidth; d.classList.add("swap");

    const layer = $("inspect"), box = $("browser").getBoundingClientRect();
    layer.innerHTML = "";
    const labelled = new Set();
    $("browser").querySelectorAll(`[data-part="${part}"]`).forEach((el) => {
      const r = el.getBoundingClientRect(), pad = 3;
      const ov = document.createElement("div");
      ov.className = "ov";
      ov.style.left = `${r.left - box.left - pad}px`;
      ov.style.top = `${r.top - box.top - pad}px`;
      ov.style.width = `${r.width + pad * 2}px`;
      ov.style.height = `${r.height + pad * 2}px`;
      // Label each file once, so four product cards show one "blocks/product-card.liquid" tag.
      if (el.dataset.file && !labelled.has(el.dataset.file)) {
        labelled.add(el.dataset.file);
        const tag = document.createElement("b");
        tag.textContent = el.dataset.file;
        ov.appendChild(tag);
        if (r.top - box.top < 24) ov.classList.add("below");
      }
      layer.appendChild(ov);
    });
  }
  // The tour runs while "Auto tour" is on; hovering the page pauses it, picking a folder turns it off.
  let tourPaused = false;
  const autoTour = $("autoTour");

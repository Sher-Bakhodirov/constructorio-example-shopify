  // A small highlighter: comments, strings, keywords and calls for JS; comments and strings for CSS;
  // Liquid tags and HTML tags for Liquid. Good enough for slides, not a parser.
  function highlight(code, lang) {
    const out = [];
    let inBlock = false;
    for (const line of code.split("\n")) {
      let html = "", i = 0;
      while (i < line.length) {
        if (inBlock) {
          const end = line.indexOf("*/", i);
          const stop = end === -1 ? line.length : end + 2;
          html += `<span class="tk-com">${esc(line.slice(i, stop))}</span>`;
          i = stop;
          if (end !== -1) inBlock = false;
          continue;
        }
        const rest = line.slice(i);
        let m;
        if (lang !== "liquid" && rest.startsWith("/*")) { inBlock = true; continue; }
        if (lang === "js" && rest.startsWith("//")) { html += `<span class="tk-com">${esc(rest)}</span>`; break; }
        if (lang === "liquid" && (m = rest.match(/^(\{%-?[\s\S]*?-?%\}|\{\{-?[\s\S]*?-?\}\})/))) { html += `<span class="tk-kw">${esc(m[0])}</span>`; i += m[0].length; continue; }
        if (lang === "liquid" && rest.startsWith("{%")) { html += `<span class="tk-kw">${esc(rest)}</span>`; break; }
        if (lang === "liquid" && (m = rest.match(/^<\/?[a-zA-Z][\w-]*/))) { html += `<span class="tk-tag">${esc(m[0])}</span>`; i += m[0].length; continue; }
        if ((m = rest.match(/^(['"`])(?:\\.|(?!\1).)*\1/))) { html += `<span class="tk-str">${esc(m[0])}</span>`; i += m[0].length; continue; }
        if (lang === "js" && (m = rest.match(/^[A-Za-z_$][\w$]*/))) {
          const w = m[0], after = line[i + w.length];
          html += KW.test(w) ? `<span class="tk-kw">${w}</span>` : after === "(" ? `<span class="tk-fn">${w}</span>` : w;
          i += w.length;
          continue;
        }
        html += esc(line[i]);
        i++;
      }
      out.push(html);
    }
    return out;
  }

  let edFile = "js", edOpen = false;
  function showFile(key) {
    edFile = key;
    const f = SOURCE[key];
    const lines = f.lang === "min" ? [esc(f.code)] : highlight(f.code, f.lang);
    const box = $("edCode");
    box.innerHTML = "";
    box.classList.toggle("min", f.lang === "min");
    if (f.banner) {
      const b = document.createElement("div");
      b.className = "min-banner";
      f.banner.forEach(([v, l]) => { const sp = document.createElement("span"); sp.innerHTML = `<b>${esc(v)}</b>${esc(l)}`; b.appendChild(sp); });
      box.appendChild(b);
    }
    lines.forEach((html, idx) => {
      const n = idx + 1;
      const mark = f.marks.find(([a, b]) => n >= a && n <= b);
      const row = document.createElement("div");
      row.className = "cl" + (mark ? " hl" : "");
      row.innerHTML = `<span class="n">${n}</span><span class="c">${html || " "}</span>`;
      if (mark && mark[0] === n) {
        const note = document.createElement("span");
        note.className = "note";
        note.textContent = mark[2];
        row.querySelector(".c").appendChild(note);
      }
      box.appendChild(row);
    });
    if (f.foot) {
      const ft = document.createElement("div");
      ft.className = "min-foot";
      ft.textContent = f.foot;
      box.appendChild(ft);
    }

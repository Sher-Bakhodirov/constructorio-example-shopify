            <div class="repo" id="repo">
              <div class="repo-label">Uploaded to Shopify</div>
              <div class="repo-list"><span class="trow">layout/</span><span class="trow">templates/</span><span class="trow">sections/</span><span class="trow">blocks/</span><span class="trow">snippets/</span><span class="trow">assets/</span><span class="trow">config/</span><span class="trow">locales/</span></div>

        "cio_plp_styles": {
          "type": "custom-liquid",
          "name": "Constructor PLP styles",
          "settings": {
            "custom_liquid": "<style>\n/* Constructor Connect PLP block: a quiet, editorial \"luxury\" look \u2014 no code, just CSS. */\n@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&display=swap');\n\n#cio-plp-ui-container {\n  --lux-ink: #1c1a17;\n  --lux-muted: #8a847b;\n  --lux-line: #e7e2da;\n  --lux-sand: #f4f1ec;\n  --lux-serif: 'Cormorant Garamond', 'Times New Roman', serif;\n\n  width: 100%;\n  color: var(--lux-ink);\n  font-family: inherit;\n}\n\n/* Layout: narrow filter column, generous gutters */\n#cio-plp-ui-container .cio-plp-grid {\n  grid-template-columns: 240px 1fr;\n  gap: 64px;\n  padding: 24px 0 80px;\n}\n\n#cio-plp-ui-container .cio-filters-container {\n  padding: 0;\n}\n\n/* Header: breadcrumbs + sort */\n#cio-plp-ui-container .cio-products-header-container {\n  margin-bottom: 40px;\n  padding-bottom: 16px;\n  border-bottom: 1px solid var(--lux-line);\n}\n\n#cio-plp-ui-container .cio-breadcrumbs-container {\n  padding: 0;\n  gap: 10px;\n  font-size: 11px;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  color: var(--lux-muted);\n}\n\n#cio-plp-ui-container .cio-breadcrumbs-container img {\n  display: none;\n}\n\n#cio-plp-ui-container .cio-plp-parent-breadcrumb::after {\n  content: '/';\n  margin-left: 10px;\n}\n\n#cio-plp-ui-container .cio-breadcrumbs-container a {\n  color: inherit;\n  text-decoration: none;\n}\n\n#cio-plp-ui-container .cio-plp-breadcrumb span {\n  color: var(--lux-ink);\n}\n\n#cio-plp-ui-container .cio-plp-sort .collapsible {\n  min-width: 0;\n  padding: 0;\n  border: 0;\n  font-size: 11px;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  color: var(--lux-ink);\n}\n\n#cio-plp-ui-container .cio-plp-sort .collapsible-content {\n  left: auto;\n  right: 0;\n  z-index: 5;\n  min-width: 200px;\n  margin-top: 12px;\n  padding: 8px 0;\n  border: 1px solid var(--lux-line);\n  box-shadow: 0 12px 32px rgb(28 26 23 / 8%);\n}\n\n#cio-plp-ui-container .cio-plp-sort label span {\n  padding: 10px 16px;\n  font-size: 13px;\n}\n\n#cio-plp-ui-container .cio-plp-sort .arrow {\n  padding: 3px;\n  border-width: 0 1px 1px 0;\n  border-color: var(--lux-ink);\n}\n\n/* Product grid: three wide tiles, lots of air */\n#cio-plp-ui-container .cio-product-tiles-container {\n  grid-template-columns: repeat(3, 1fr);\n  gap: 56px 32px;\n}\n\n#cio-plp-ui-container .cio-products-container .cio-product-tile {\n  padding: 0;\n}\n\n#cio-plp-ui-container .cio-product-card {\n  display: flex;\n  flex-direction: column;\n  align-items: stretch;\n  height: 100%;\n  color: inherit;\n  text-decoration: none;\n}\n\n#cio-plp-ui-container .cio-image-container {\n  max-width: none;\n  aspect-ratio: 4 / 5;\n  overflow: hidden;\n  background: var(--lux-sand);\n}\n\n#cio-plp-ui-container .cio-image {\n  box-sizing: border-box;\n  padding: 12%;\n  object-fit: contain;\n  mix-blend-mode: multiply;\n  transition: transform 1.2s cubic-bezier(0.2, 0.7, 0.2, 1);\n}\n\n#cio-plp-ui-container .cio-product-card:hover .cio-image {\n  transform: scale(1.04);\n}\n\n/* Name above price, like a boutique label */\n#cio-plp-ui-container .cio-content {\n  display: flex;\n  flex-direction: column-reverse;\n  gap: 6px;\n  margin: 20px 0 16px;\n  text-align: center;\n}\n\n#cio-plp-ui-container .cio-item-name {\n  margin: 0;\n  font-family: var(--lux-serif);\n  font-size: 21px;\n  font-weight: 400;\n  line-height: 1.25;\n  color: var(--lux-ink);\n}\n\n#cio-plp-ui-container .cio-item-price {\n  margin: 0;\n  font-size: 12px;\n  font-weight: 400;\n  letter-spacing: 0.16em;\n  color: var(--lux-muted);\n}\n\n#cio-plp-ui-container .cio-content > div:has(.cio-swatch-container:empty) {\n  display: none;\n}\n\n/* Add to cart: a hairline button that fades in on hover */\n#cio-plp-ui-container .cio-add-to-cart-button {\n  height: 44px;\n  border: 1px solid var(--lux-ink);\n  border-radius: 0;\n  background: transparent;\n  color: var(--lux-ink);\n  font-size: 11px;\n  letter-spacing: 0.2em;\n  text-transform: uppercase;\n  transition: background-color 0.3s, color 0.3s, opacity 0.3s;\n}\n\n#cio-plp-ui-container .cio-add-to-cart-button:hover {\n  background: var(--lux-ink);\n  color: #fff;\n}\n\n@media (hover: hover) {\n  #cio-plp-ui-container .cio-add-to-cart-button {\n    opacity: 0;\n  }\n\n  #cio-plp-ui-container .cio-product-card:hover .cio-add-to-cart-button {\n    opacity: 1;\n  }\n}\n\n/* Filters: small caps headings, hairline dividers */\n#cio-plp-ui-container .cio-filters-container .cio-breadcrumbs-container,\n#cio-plp-ui-container .cio-groups-container .cio-breadcrumbs-container {\n  padding: 4px 0 12px;\n}\n\n#cio-plp-ui-container .cio-groups-container a,\n#cio-plp-ui-container .cio-groups-container button {\n  font-size: 14px;\n  color: var(--lux-ink);\n  text-decoration: none;\n}\n\n#cio-plp-ui-container .cio-filter-header {\n  margin-bottom: 16px;\n  padding: 0 0 12px;\n  border-bottom: 1px solid var(--lux-line);\n  font-size: 11px;\n  font-weight: 500;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  color: var(--lux-ink);\n}\n\n#cio-plp-ui-container .cio-filter-header .cio-arrow {\n  padding: 3px;\n  border-width: 0 1px 1px 0;\n}\n\n#cio-plp-ui-container .cio-filter-group {\n  margin-bottom: 28px;\n  list-style: none;\n}\n\n#cio-plp-ui-container .cio-filter-multiple-option input {\n  display: none;\n}\n\n#cio-plp-ui-container .cio-filter-multiple-option label {\n  padding: 5px 0;\n  font-size: 14px;\n  cursor: pointer;\n}\n\n#cio-plp-ui-container .cio-checkbox {\n  width: 14px;\n  height: 14px;\n  min-width: 14px;\n  min-height: 14px;\n  margin-right: 12px;\n  border: 1px solid var(--lux-ink);\n  border-radius: 0;\n}\n\n#cio-plp-ui-container .cio-filter-multiple-option:has(input:checked) .cio-checkbox {\n  box-shadow: inset 0 0 0 32px var(--lux-ink);\n}\n\n#cio-plp-ui-container .cio-filter-option-count {\n  font-size: 12px;\n  color: var(--lux-muted);\n}\n\n/* Price range */\n#cio-plp-ui-container .cio-slider-input {\n  border: 0;\n  border-bottom: 1px solid var(--lux-line);\n  border-radius: 0;\n  color: var(--lux-muted);\n}\n\n#cio-plp-ui-container .cio-doubly-ended-slider {\n  height: 1px;\n  background: var(--lux-line);\n}\n\n#cio-plp-ui-container .cio-slider-track-selected {\n  height: 1px;\n  background: var(--lux-ink);\n}\n\n/* Pagination: plain numbers, the current page underlined */\n#cio-plp-ui-container .cio-products-container .cio-pagination-container {\n  margin-top: 72px;\n}\n\n#cio-plp-ui-container .cio-pagination button {\n  margin: 0 6px;\n  padding: 6px 8px;\n  border: 0;\n  border-bottom: 1px solid transparent;\n  background: none;\n  color: var(--lux-muted);\n  font-size: 13px;\n  letter-spacing: 0.1em;\n}\n\n#cio-plp-ui-container .cio-pagination button.selected {\n  border-bottom-color: var(--lux-ink);\n  background: none;\n  color: var(--lux-ink);\n}\n\n#cio-plp-ui-container .cio-pagination button:hover:not(.selected) {\n  background: none;\n  color: var(--lux-ink);\n}\n\n@media (max-width: 989px) {\n  #cio-plp-ui-container .cio-plp-grid {\n    grid-template-columns: 1fr;\n    gap: 32px;\n  }\n\n  #cio-plp-ui-container .cio-product-tiles-container {\n    grid-template-columns: repeat(2, 1fr);\n    gap: 40px 16px;\n  }\n\n  #cio-plp-ui-container .cio-item-name {\n    font-size: 18px;\n  }\n\n  /* Touch screens have no hover, so the button is always shown; keep it compact. */\n  #cio-plp-ui-container .cio-add-to-cart-button {\n    height: 36px;\n    font-size: 10px;\n  }\n}\n</style>"
